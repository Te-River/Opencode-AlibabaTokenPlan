{
  "name": "@te-river/opencode-alibabatokenplan",
  "version": "0.2.18",
  "description": "OpenCode v2 TUI plugin: Aliyun Bailian Token Plan personal quota and discount windows in one panel.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/tui.d.ts",
      "default": "./dist/tui.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "default": "./dist/tui.js"
    }
  },
  "files": [
    "dist/tui.js",
    "dist/tui.d.ts",
    "README.md",
    "CHANGELOG.md",
    "AGENT_INSTALL.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "publish:check": "npm run build && npm test && npm run smoke && npm pack --dry-run"
  },
  "keywords": [
    "opencode",
    "plugin",
    "tui",
    "opentui",
    "bailian",
    "token-plan",
    "discount"
  ],
  "author": "te-river",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/te-river/opencode-alibabatokenplan.git"
  },
  "bugs": {
    "url": "https://github.com/te-river/opencode-alibabatokenplan/issues"
  },
  "homepage": "https://github.com/te-river/opencode-alibabatokenplan#readme",
  "dependencies": {
    "@opentui/core": "^0.5.10",
    "@opentui/solid": "^0.5.10",
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-typescript": "^7.27.1",
    "@opencode/plugin": "2.0.16",
    "@types/node": "^22.0.0",
    "babel-preset-solid": "^1.9.12",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@opencode/plugin": "2.0.16"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.5.0"
  }
}

